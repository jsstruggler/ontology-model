{
  "name": "ontology-model-jsstruggler",
  "version": "1.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsstruggler/ontologyModel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/ontologyModel.umd.cjs",
  "module": "./dist/ontologyModel.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ontologyModel.js",
      "require": "./dist/ontologyModel.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "gen:schema": "ts-json-schema-generator --path 'src/index.ts' --type 'OntologyModelData' --out 'schema.json'"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ts-json-schema-generator": "^2.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^5.1.2"
  }
}
